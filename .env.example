# Скопируйте в .env рядом с ботом (/opt/sro-bot/.env на VPS).
# .env в git не класть. Уже заданные переменные окружения этот файл не перебивает.

# deepseek — напрямую api.deepseek.com, без прокси в Нидерландах.
# openrouter — прежний путь (OPENROUTER_API_KEY и OPENROUTER_BASE в config_keys.py).
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Имя из задания. С 24.07.2026 deepseek-chat снят; бот шлёт deepseek-flash
# и выключает thinking, чтобы короткие ответы (роутер тем) не ломались.
DEEPSEEK_MODEL=deepseek-chat
